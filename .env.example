# LeadFlowProTeam - Environment Variables
# Copy this file to .env.local for local development, and set the
# same variables in Vercel (Project Settings > Environment Variables)
# for production deployments.

# --- Lead Capture ---
# URL of the Google Apps Script Web App that appends audit-form leads
# to the "Leads" Google Sheet.
# If this is missing, audit submissions still work - but leads are
# NOT saved to the sheet (the API response will show
# leadSaveStatus: "not-configured").
GOOGLE_APPS_SCRIPT_URL=

# --- Public site URL ---
# Used for canonical URLs and metadata in some environments.
NEXT_PUBLIC_SITE_URL=https://leadflowproteam.com
